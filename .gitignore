# Build output binaries (keep source, exclude compiled output)
src/Release/*.dll
src/Release/*.exe
src/Debug/*.dll
src/Debug/*.exe

# FPC / Pascal / Delphi compiled unit & object files
*.o
*.ppu
*.dcu
*.dcp
*.dres
*.compiled
*.identcache
*.lps

# Lazarus/FPC build executables (launcher build outputs)
launcher/Experimente/**/*.exe
launcher/Source/**/*.exe

# Root-level build logs
build_release.log
build_debug.log
*.build.log

# Python cache
__pycache__/
*.py[cod]
*.pyo

# macOS metadata
.DS_Store

# Windows thumbnails
Thumbs.db


